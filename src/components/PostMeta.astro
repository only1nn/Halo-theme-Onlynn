---
interface Props {
  class?: string;
  hideTagsForMobile?: boolean;
  hideUpdateDate?: boolean;
  hideDate?: boolean;
}

const {
  hideTagsForMobile = false,
  hideUpdateDate = false,
  hideDate = false,
} = Astro.props;
const className = Astro.props.class;

/*
  热度 ℃：后台「文章 → 文章信息 → 显示文章热度」打开时显示。
  公式 24 + 浏览量×0.1 + 点赞×2 + 评论×3（与参考实现的观感一致：新文章起点即 24℃，
  评论权重最高）。数据来自 Halo 主题侧的 post.stats（PostVo 与 ListedPostVo 都有
  visit/upvote/comment，列表页与文章页均可用），故可以在服务端算完直接渲染。
  ⚠ 表达式里的 ?: 必须加括号：SpEL 的 Elvis 优先级低于算术，不括会把整段算成 null。
*/
const heatCfg = "theme.config?.post?.meta?.heat";
const heat = `24 + (post.stats?.visit ?: 0) * 0.1 + (post.stats?.upvote ?: 0) * 2 + (post.stats?.comment ?: 0) * 3`;
---

<div
  class:list={[
    "flex flex-wrap items-center gap-4 gap-x-4 gap-y-2 text-neutral-500 dark:text-neutral-400",
    className,
  ]}
  th:with={`heat = \${${heat}}`}
>
  <!-- 置顶徽章：后台文章「置顶」开关打开时显示（Halo 列表接口会自动把置顶文章排最前）。
       文案走 i18n post.pinned，勿硬编码 -->
  <div
    class="inline-flex shrink-0 items-center gap-1 rounded-md bg-(--primary)/10 px-2 py-1.5 font-bold text-(--primary) dark:bg-(--primary)/15"
    th:if="${post.spec.pinned == true}"
  >
    <span class="icon-[material-symbols--pinboard] text-xl leading-none"></span>
    <span class="text-sm leading-none" th:text="#{post.pinned}">Pinned</span>
  </div>

  <div class="flex items-center" hidden={hideDate}>
    <div class="meta-icon">
      <span
        class="icon-[material-symbols--calendar-today-outline-rounded] text-xl"
      ></span>
    </div>
    <span
      class="text-sm font-medium text-50"
      th:text="${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}"
      >2026-01-01</span
    >
  </div>

  <div
    class="flex items-center"
    th:unless="${#strings.equals(#dates.format(post.spec.publishTime, 'yyyy-MM-dd HH:mm:ss'), #dates.format(post.status.lastModifyTime, 'yyyy-MM-dd HH:mm:ss'))}"
    hidden={hideUpdateDate}
  >
    <div class="meta-icon">
      <span
        class="icon-[material-symbols--edit-calendar-outline-rounded] text-xl"
      ></span>
    </div>
    <span
      class="text-sm font-medium text-50"
      th:text="${#dates.format(post.status.lastModifyTime, 'yyyy-MM-dd')}"
      >2026-01-01</span
    >
  </div>

  <!-- 热度：数值越高越「烫」，三档配色。图标与数值同色，避免读成两个元素 -->
  <div class="flex items-center" th:if={`\${${heatCfg} != false}`}>
    <div
      class="meta-icon"
      th:classappend={`\${heat >= 80 ? 'bg-red-500/10 text-red-500 dark:text-red-400' : (heat >= 40 ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400' : '')}`}
    >
      <span
        class="icon-[material-symbols--local-fire-department-rounded] text-xl"
      ></span>
    </div>
    <span
      class="text-sm font-medium"
      th:classappend={`\${heat >= 80 ? 'text-red-500 dark:text-red-400' : (heat >= 40 ? 'text-amber-600 dark:text-amber-400' : 'text-50')}`}
      th:text={`\${#numbers.formatDecimal(heat, 1, 0)} + '℃'`}>24℃</span
    >
  </div>

  <div class="flex items-center" th:if="${not #lists.isEmpty(post.categories)}">
    <div class="meta-icon">
      <span class="icon-[material-symbols--book-2-outline-rounded] text-xl"
      ></span>
    </div>
    <div class="flex flex-row flex-nowrap items-center">
      <span
        class="contents"
        th:each="category, categoryStat : ${post.categories}"
      >
        <span
          th:if="${categoryStat.index > 0}"
          class="mx-1.5 text-sm text-(--meta-divider) transition">/</span
        >
        <a
          th:href="@{${category.status.permalink}}"
          class="link-lg whitespace-nowrap text-sm font-medium text-50 transition hover:text-(--primary) active:scale-95 dark:hover:text-(--primary)"
          th:text="${category.spec.displayName}">Category</a
        >
      </span>
    </div>
  </div>

  <div
    class:list={[
      "items-center",
      { "hidden md:flex": hideTagsForMobile, flex: !hideTagsForMobile },
    ]}
    th:if="${not #lists.isEmpty(post.tags)}"
  >
    <div class="meta-icon">
      <span class="icon-[material-symbols--tag-rounded] text-xl"></span>
    </div>
    <div class="flex flex-row flex-nowrap items-center">
      <span class="contents" th:each="tag, tagStat : ${post.tags}">
        <span
          th:if="${tagStat.index > 0}"
          class="mx-1.5 text-sm text-(--meta-divider) transition">/</span
        >
        <a
          th:href="@{${tag.status.permalink}}"
          class="link-lg whitespace-nowrap text-sm font-medium text-50 transition hover:text-(--primary) active:scale-95 dark:hover:text-(--primary)"
          th:text="${tag.spec.displayName}">Tag</a
        >
      </span>
    </div>
  </div>
</div>
