<div
  id="config-carrier"
  th:data-hue="${theme.config?.style?.displayPanel?.themeColor?.hue}"
  th:data-hue-fixed="${theme.config?.style?.visitorStyle?.enable == false or theme.config?.style?.visitorStyle?.hue == false}"
  th:data-theme-name="${theme.metadata.name}"
  th:data-visitor-enable="${theme.config?.style?.visitorStyle?.enable != false}"
  th:data-visitor-layout="${theme.config?.style?.visitorStyle?.postListLayout != false}"
  th:data-visitor-card-style="${theme.config?.style?.visitorStyle?.cardStyle != false}"
  th:data-masonry-default="${theme.config?.style?.displayPanel?.appearanceDefaults?.postListMasonry == true}"
  th:data-visitor-transparent="${theme.config?.style?.visitorStyle?.transparent != false}"
  th:data-visitor-wallpaper-mode="${theme.config?.style?.visitorStyle?.wallpaperMode != false}"
  th:data-fullscreen-layout-default="${#strings.defaultString(theme.config?.style?.displayPanel?.wallpaperDefaults?.fullscreenLayout, 'classic')}"
  th:data-visitor-fullscreen-layout="${theme.config?.style?.visitorStyle?.fullscreenLayout != false}"
  th:data-banner-display-default="${#strings.defaultString(theme.config?.style?.displayPanel?.wallpaperDefaults?.displayMode, 'banner')}"
  th:data-visitor-wallpaper-settings="${theme.config?.style?.visitorStyle?.wallpaperSettings != false}"
  th:data-banner-title-default="${theme.config?.style?.bannerText?.enable != false and (!#strings.isEmpty(theme.config?.style?.bannerText?.title) or !#strings.isEmpty(theme.config?.style?.bannerText?.subtitles))}"
  th:data-visitor-carousel="${theme.config?.style?.visitorStyle?.carousel != false}"
  th:data-gradient-default="${theme.config?.style?.styleSwitches?.banner_gradient != false}"
  th:data-visitor-gradient="${theme.config?.style?.visitorStyle?.gradient != false}"
  th:data-wave-default="${theme.config?.style?.styleSwitches?.banner_wave != false and theme.config?.style?.styleSwitches?.banner_wave != 'disabled'}"
  th:data-sidebar-position-default="${#strings.defaultString(theme.config?.style?.displayPanel?.appearanceDefaults?.sidebarPosition, 'left')}"
  th:data-visitor-sidebar-position="${theme.config?.style?.visitorStyle?.sidebarPosition != false}"
  th:data-sakura-default="${theme.config?.style?.sakura?.enable == true}"
  th:data-visitor-sakura="${theme.config?.style?.visitorStyle?.sakura != false}"
  th:data-card-border-default="${theme.config?.style?.styleSwitches?.card_border == true}"
  th:data-card-follow-theme-default="${theme.config?.style?.styleSwitches?.card_follow_theme == true}"
  th:data-visitor-card-border="${theme.config?.style?.visitorStyle?.cardBorder != false}"
  th:data-visitor-card-follow-theme="${theme.config?.style?.visitorStyle?.cardFollowTheme != false}"
  th:data-card-hover-lift="${theme.config?.style?.styleSwitches?.card_hover_lift != false}"
  th:data-navbar-blur="${theme.config?.style?.styleSwitches?.navbar_blur == true}"
  th:data-wallpaper-opacity="${theme.config?.style?.displayPanel?.wallpaperDefaults?.wallpaperOpacity ?: 0.8}"
  th:data-wallpaper-blur="${theme.config?.style?.displayPanel?.wallpaperDefaults?.wallpaperBlur ?: 10}"
  th:data-wallpaper-card-alpha="${theme.config?.style?.displayPanel?.wallpaperDefaults?.cardOpacity ?: 0.6}"
>
</div>
