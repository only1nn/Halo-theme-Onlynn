---
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
}

const className = Astro.props.class;
---

<WidgetLayout
  name="一言"
  nameKey="widget.hitokoto.title"
  id="hitokoto"
  class={className}
>
  <style>
    .hitokoto-card {
      line-height: 1.6;
      max-width: 100%;
      box-sizing: border-box;
    }

    .hitokoto-main-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .hitokoto-text {
      flex: 1;
      min-width: 0;
      font-size: 14px;
      color: var(--deep-text);
      word-break: break-word;
      margin: 0;
      transition: opacity 0.3s ease;
    }

    .hitokoto-refresh {
      flex-shrink: 0;
      width: 26px;
      height: 26px;
      border: none;
      background: transparent;
      cursor: pointer;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--deep-text);
      opacity: 0.4;
      transition:
        color 0.2s,
        background 0.2s,
        opacity 0.2s;
      padding: 0;
      margin-top: 1px;
      font-size: 15px;
    }

    .hitokoto-refresh:hover {
      opacity: 0.7;
      background: rgba(128, 128, 128, 0.1);
    }

    .hitokoto-refresh:active {
      transform: scale(0.9);
    }

    .hitokoto-refresh .iconify-spin {
      transition: transform 0.4s ease;
    }

    .hitokoto-refresh.spinning .iconify-spin {
      transform: rotate(360deg);
    }

    .hitokoto-author-row {
      margin-top: 6px;
    }

    .hitokoto-author {
      font-size: 12px;
      color: var(--deep-text);
      opacity: 0.5;
      display: block;
      text-align: right;
    }

    .hitokoto-author::before {
      content: "—— ";
    }

    .hitokoto-loading .hitokoto-text {
      opacity: 0.5;
    }
  </style>

  <div
    class="hitokoto-card px-3"
    data-hitokoto-card
    th:attr="data-api=${widget.hitokoto_api ?: widget.api},
      data-fallback-text=${widget.fallback_text},
      data-fallback-source=${widget.fallback_source}"
  >
    <div class="hitokoto-main-row">
      <p
        class="hitokoto-text"
        data-hitokoto-text
        th:text="#{widget.hitokoto.loading}"
      >
        加载中...
      </p>
      <button
        class="hitokoto-refresh"
        data-hitokoto-refresh
        title="换一句"
        aria-label="换一句"
        th:title="#{widget.hitokoto.refresh}"
        th:aria-label="#{widget.hitokoto.refresh}"
      >
        <span class="icon-[material-symbols--refresh-rounded] iconify-spin"
        ></span>
      </button>
    </div>
    <div class="hitokoto-author-row">
      <span class="hitokoto-author" data-hitokoto-author></span>
    </div>
  </div>
</WidgetLayout>

<script is:inline>
  (function () {
    // 同一份文档里是否已经取过一次：整页加载（F5 / 新标签页）是新的文档，
    // 站内换页由 Swup 重执行本脚本，共用同一份窗口
    var DOC_FLAG = "__onlynnHitokotoFetched";
    // 同一次文档里的在途请求：左右侧栏都放了一言时不会各发一份
    var DOC_PENDING = "__onlynnHitokotoPending";

    function getCachedData(key) {
      try {
        var raw = sessionStorage.getItem(key);
        if (raw) return JSON.parse(raw);
      } catch (e) {}
      return null;
    }

    function setCachedData(key, data) {
      try {
        sessionStorage.setItem(key, JSON.stringify(data));
      } catch (e) {}
    }

    // 取到句子返回对象，取不到返回 null（由调用方决定显示兜底文案，且不写缓存）
    async function fetchHitokoto(API) {
      try {
        // no-store：一言接口不带 Cache-Control，别让中途的缓存把同一句复用回来
        var resp = await fetch(API, {
          cache: "no-store",
          signal: AbortSignal.timeout(5000),
        });
        if (!resp.ok) throw new Error("Network response was not ok.");
        var contentType = resp.headers.get("content-type") || "";
        // JSON 响应：兼容 hitokoto 标准字段与常见自定义字段
        if (contentType.indexOf("application/json") !== -1) {
          var data = await resp.json();
          var content =
            data.hitokoto || data.content || data.sentence || data.text || "";
          if (!content) throw new Error("Empty quote.");
          return {
            content: content,
            author:
              data.from || data.author || data.source || data.from_who || "",
          };
        }
        // 纯文本响应
        var text = (await resp.text()).trim();
        if (!text) throw new Error("Empty quote.");
        return { content: text, author: "" };
      } catch (e) {
        console.warn("一言获取失败，使用默认句子", e.message);
        return null;
      }
    }

    // 每张卡片各自初始化：同一份文档里可能有两张（左右侧栏都放了一言）
    function setupCard(card) {
      var textEl = card.querySelector("[data-hitokoto-text]");
      var authorEl = card.querySelector("[data-hitokoto-author]");
      var refreshBtn = card.querySelector("[data-hitokoto-refresh]");
      if (!textEl || !authorEl || !refreshBtn) return;

      // 读取后台配置：留空则使用内置默认
      var API = card.getAttribute("data-api") || "https://v1.hitokoto.cn/";
      var fallbackText =
        card.getAttribute("data-fallback-text") ||
        "愿做檐下一株草，不争不抢，自在生长。";
      var fallbackSource =
        card.getAttribute("data-fallback-source") || "楠香自语";

      // 缓存按 API 区分，避免更换 API 后读到旧缓存
      var CACHE_KEY = "hitokoto_cache_" + encodeURIComponent(API);
      // 在途请求同样按 API 区分
      var PENDING_KEY = DOC_PENDING + ":" + CACHE_KEY;

      function updateCard(data) {
        textEl.textContent = data.content;
        authorEl.textContent = data.author || "";
        card.classList.remove("hitokoto-loading");
      }

      // forceNew 为真时一定重新请求（手动「换一句」），
      // 否则复用同一次文档内其它卡片已经在跑的请求
      function load(forceNew) {
        card.classList.add("hitokoto-loading");
        refreshBtn.classList.add("spinning");
        var pending = forceNew ? null : window[PENDING_KEY];
        if (!pending) {
          pending = fetchHitokoto(API).then(function (data) {
            // 请求落地就不再算「在途」；失败则连占位一起清掉，
            // 否则一次网络抖动会让后面的换页不再重试
            window[PENDING_KEY] = null;
            if (data) setCachedData(CACHE_KEY, data);
            return data;
          });
          window[PENDING_KEY] = pending;
        }
        pending.then(function (data) {
          updateCard(data || { content: fallbackText, author: fallbackSource });
          setTimeout(function () {
            refreshBtn.classList.remove("spinning");
          }, 400);
        });
      }

      // 同一张卡片只绑一次（换页后是新节点，会重新绑）
      if (refreshBtn.dataset.hitokotoBound !== "true") {
        refreshBtn.dataset.hitokotoBound = "true";
        refreshBtn.addEventListener("click", function () {
          load(true);
        });
      }

      var cached = getCachedData(CACHE_KEY);
      // 先把上一句显示出来，别让卡片在请求期间空着
      if (cached) updateCard(cached);

      // 站内换页（Swup 重执行本脚本）沿用这一句，不再请求；
      // 整页加载一定取新的，同一份文档里的每张卡片都要跟上这次请求
      if (cached && window[DOC_FLAG] === true && !window[PENDING_KEY]) return;
      window[DOC_FLAG] = true;
      load(false);
    }

    function initHitokoto() {
      var cards = document.querySelectorAll("[data-hitokoto-card]");
      for (var i = 0; i < cards.length; i++) setupCard(cards[i]);
    }

    // 初始化；换页后由 SwupScriptsPlugin 重执行本脚本时自动重新初始化
    // （原 swup:contentReplaced 监听删除：v3 事件名从未触发）
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHitokoto);
    } else {
      initHitokoto();
    }
  })();
</script>
